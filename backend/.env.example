# --- Server Config ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Must match the PostgreSQL instance from the README's docker run command.
DATABASE_URL="postgres://postgres:admin@localhost:5432/market_db"

# --- Data ingestion ---
# Set to false to run the API against an already populated database.
ENABLE_INGESTOR=true
# Each poll sweeps every open market (paginated), so keep these around a minute.
KALSHI_POLLING_INTERVAL_MS=60000
POLYMARKET_POLLING_INTERVAL_MS=60000
# KALSHI_MAX_PAGES=50        # 200 events per page
# POLYMARKET_MAX_PAGES=50    # 100 markets per page
# Only markets usable as an arbitrage leg are stored (see src/api-clients/market-quality.ts):
# something must be buyable, the market must have traded (or have open interest on Kalshi),
# the book must have size, and the YES spread must not be absurdly wide.
# INGEST_MIN_VOLUME=1                  # lifetime volume (Kalshi contracts / Polymarket $)
# INGEST_MIN_BOOK_DEPTH=1              # Kalshi: contracts at best YES bid + ask
# INGEST_MIN_POLYMARKET_LIQUIDITY=10   # Polymarket: Gamma order-book liquidity, $
# INGEST_MAX_SPREAD=0.4                # max YES ask - bid, $
# After a complete sweep, delete stored markets it no longer returned (keeps saved matches' markets).
# INGEST_PRUNE_STALE=true

# --- Matching / arbitrage ---
# DEFAULT_MATCH_LIMIT=300    # markets per platform per match run, by volume
# KALSHI_TAKER_FEE_RATE=0.07
# POLYMARKET_TAKER_FEE_RATE=0

# --- LLM API Keys ---
# ANTHROPIC_API_KEY alone runs single-agent matching.
# Add both GEMINI_API_KEY and OPENAI_API_KEY to enable multi-agent consensus.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Set to "single" to use Claude only even if the Gemini/OpenAI keys are set.
# MATCHING_MODE=single
# CLAUDE_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o

# --- Alerting (optional) ---
DISCORD_WEBHOOK_URL=""
