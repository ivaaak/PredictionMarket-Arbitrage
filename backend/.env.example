# --- Server Config ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Must match the PostgreSQL instance from the README's docker run command.
DATABASE_URL="postgres://postgres:admin@localhost:5432/market_db"

# --- Data ingestion ---
# Set to false to run the API against an already populated database.
ENABLE_INGESTOR=true
KALSHI_POLLING_INTERVAL_MS=5000

# --- LLM API Keys ---
# ANTHROPIC_API_KEY alone runs single-agent matching.
# Add both GEMINI_API_KEY and OPENAI_API_KEY to enable multi-agent consensus.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --- Alerting (optional) ---
DISCORD_WEBHOOK_URL=""
