# --- Server Config ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Must match the PostgreSQL instance from the README's docker run command.
DATABASE_URL="postgres://postgres:admin@localhost:5432/market_db"

# --- Data ingestion ---
# Set to false to run the API against an already populated database.
ENABLE_INGESTOR=true
# Each poll sweeps every open market (paginated), so keep these around a minute.
KALSHI_POLLING_INTERVAL_MS=60000
POLYMARKET_POLLING_INTERVAL_MS=60000
# KALSHI_MAX_PAGES=50        # 200 events per page
# POLYMARKET_MAX_PAGES=10    # 500 markets per page

# --- Matching / arbitrage ---
# DEFAULT_MATCH_LIMIT=300    # markets per platform per match run, by volume
# KALSHI_TAKER_FEE_RATE=0.07
# POLYMARKET_TAKER_FEE_RATE=0

# --- LLM API Keys ---
# ANTHROPIC_API_KEY alone runs single-agent matching.
# Add both GEMINI_API_KEY and OPENAI_API_KEY to enable multi-agent consensus.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# CLAUDE_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o

# --- Alerting (optional) ---
DISCORD_WEBHOOK_URL=""
