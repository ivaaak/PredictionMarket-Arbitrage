    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^6.9.1",
    "pg": "^8.16.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
