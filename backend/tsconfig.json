{
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "es2016", 
    "module": "commonjs", 
    "esModuleInterop": true,  
    "forceConsistentCasingInFileNames": true, 
    "strict": true,     
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}